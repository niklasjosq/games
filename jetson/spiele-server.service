[Unit]
Description=Kinder-Spieleplattform (statischer Webserver)
After=network-online.target
Wants=network-online.target

[Service]
# ↓↓↓ Diese beiden Zeilen auf den eigenen Benutzer und Pfad anpassen ↓↓↓
User=jetson
WorkingDirectory=/home/jetson/Games/web

# --directory kennt erst Python 3.7 — deshalb oben WorkingDirectory
ExecStart=/usr/bin/python3 -m http.server 8000 --bind 0.0.0.0

Restart=on-failure
RestartSec=5

# Etwas Absicherung: der Dienst darf nur lesen, was er ausliefert
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
